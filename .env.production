# ============================================================
# GYANDEEP - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# This file shows the required env vars for production
# DO NOT commit actual values - set them in Vercel/Render dashboards
# ============================================================

# ------------------------------------------------------------
# REQUIRED: Backend API URL (for Vite frontend)
# ------------------------------------------------------------
VITE_API_URL=https://gyandeep-1.onrender.com

# ------------------------------------------------------------
# Backend env vars should be set on Render dashboard:
# ------------------------------------------------------------

# ── REQUIRED ─────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://...

# JWT secrets (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_64_char_hex_secret
JWT_REFRESH_SECRET=your_64_char_hex_secret

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=https://gyandeep-1.vercel.app,https://gyandeep-1.onrender.com

# ── OPTIONAL: AI Features ────────────────────────────────────
# Groq keys for different purposes (all tried before Gemini fallback)
# Get Groq keys from: https://console.groq.com
GROQ_API_KEY_CHAT=your_groq_api_key_for_chatbot
GROQ_API_KEY_CONTENT=your_groq_api_key_for_content_generation
GROQ_API_KEY_ANALYTICS=your_groq_api_key_for_analytics
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini fallback (used if any Groq key is missing or fails)
# Get Gemini key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OPTIONAL: Email (Resend) ────────────────────────────────
# Get from: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ── OPTIONAL: Redis Cache (Upstash) ────────────────────────
# Get from: https://upstash.com
REDIS_URL=redis://...

# ── OPTIONAL: Security ──────────────────────────────────────
CSRF_SECRET=your_csrf_secret
LOG_LEVEL=info
TRUST_PROXY=true

# ------------------------------------------------------------
# Production checklist:
# [ ] Set VITE_API_URL in Vercel dashboard
# [ ] Set GROQ_API_KEY_CHAT, GROQ_API_KEY_CONTENT, GROQ_API_KEY_ANALYTICS in Render dashboard
# [ ] Set GEMINI_API_KEY as fallback in Render dashboard
# [ ] Set all backend vars in Render dashboard
# [ ] Whitelist Render IP in MongoDB Atlas (0.0.0.0/0 for dev)
# [ ] Redeploy frontend after adding env vars
# ------------------------------------------------------------